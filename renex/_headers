/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/js/*
  Cache-Control: no-cache, must-revalidate

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; connect-src 'self' https://api.renex.id wss://api.renex.id https://challenges.cloudflare.com; img-src 'self' data: blob: https://media.giphy.com https://media0.giphy.com https://media1.giphy.com https://media2.giphy.com https://media3.giphy.com https://media4.giphy.com; font-src 'self'; frame-src 'self' https://challenges.cloudflare.com; form-action 'self'; base-uri 'self'

# Chat-Seite: frame-ancestors 'self' erlaubt Einbettung als iframe von derselben Origin.
# X-Frame-Options SAMEORIGIN überschreibt das globale DENY für /chat*.
# Kein frame-ancestors im globalen CSP → kein Stacking-Konflikt.
/chat*
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; connect-src 'self' https://api.renex.id wss://api.renex.id https://challenges.cloudflare.com; img-src 'self' data: blob: https://media.giphy.com https://media0.giphy.com https://media1.giphy.com https://media2.giphy.com https://media3.giphy.com https://media4.giphy.com; font-src 'self'; frame-src 'self' https://challenges.cloudflare.com; frame-ancestors 'self'; form-action 'self'; base-uri 'self'
